{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "classes", "reason"],
  "properties": {
    "image": {"type": "string", "minLength": 1},
    "classes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "reason": {"type": "string"}
  }
}
