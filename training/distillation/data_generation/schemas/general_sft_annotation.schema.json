{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset", "source_id", "sample_id", "canonical_source_key", "instruction", "response", "style_audit", "direct_session_review"],
  "properties": {
    "dataset": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "canonical_source_key": {"type": "string", "minLength": 1},
    "instruction": {"type": "string", "minLength": 1},
    "response": {"type": "string", "minLength": 1},
    "style_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_source", "profile_id", "source_task_category", "task_type", "language",
        "answer_form", "prompt_pattern", "answer_pattern", "lexical_register",
        "synonym_choice_basis", "task_type_matched", "prompt_pattern_matched",
        "language_matched", "answer_form_matched", "lexical_register_matched",
        "synonym_preference_matched", "length_band_matched", "punctuation_matched",
        "terminology_matched"
      ],
      "properties": {
        "profile_source": {"type": "string", "enum": ["official_dataset_annotations"]},
        "profile_id": {"type": "string", "minLength": 1},
        "source_task_category": {"type": "string", "minLength": 1},
        "task_type": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "answer_form": {"type": "string", "minLength": 1},
        "prompt_pattern": {"type": "string", "minLength": 1},
        "answer_pattern": {"type": "string", "minLength": 1},
        "lexical_register": {"type": "string", "minLength": 1},
        "synonym_choice_basis": {"type": "string", "minLength": 1},
        "task_type_matched": {"type": "boolean", "enum": [true]},
        "prompt_pattern_matched": {"type": "boolean", "enum": [true]},
        "language_matched": {"type": "boolean", "enum": [true]},
        "answer_form_matched": {"type": "boolean", "enum": [true]},
        "lexical_register_matched": {"type": "boolean", "enum": [true]},
        "synonym_preference_matched": {"type": "boolean", "enum": [true]},
        "length_band_matched": {"type": "boolean", "enum": [true]},
        "punctuation_matched": {"type": "boolean", "enum": [true]},
        "terminology_matched": {"type": "boolean", "enum": [true]}
      }
    },
    "direct_session_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "full_image_answerable", "answer_factually_supported", "answer_complete", "style_matched", "no_annotation_leakage"],
      "properties": {
        "mode": {"type": "string", "enum": ["direct_session"]},
        "full_image_answerable": {"type": "boolean"},
        "answer_factually_supported": {"type": "boolean"},
        "answer_complete": {"type": "boolean"},
        "style_matched": {"type": "boolean"},
        "no_annotation_leakage": {"type": "boolean"}
      }
    }
  }
}
